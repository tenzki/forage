{
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://auth.openai.com/**" },
        { "url": "https://chatgpt.com/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://html.duckduckgo.com/**" },
        { "url": "https://r.jina.ai/**" },
        { "url": "https://api.github.com/**" },
        { "url": "https://api.open-meteo.com/**" }
      ]
    },
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node-sidecar",
          "cmd": "node",
          "sidecar": false,
          "args": [
            { "validator": "^.+node_modules/tsx/dist/cli\\.mjs$" },
            { "validator": "^.+sidecar/index\\.ts$" }
          ]
        },
        {
          "name": "node-version",
          "cmd": "node",
          "sidecar": false,
          "args": ["--version"]
        },
        {
          "name": "codex-version",
          "cmd": "codex",
          "sidecar": false,
          "args": ["--version"]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Forage" },
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Forage/**" },
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/AIChat" },
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/AIChat/**" },
        { "path": "$HOME/Library/Application Support/com.forage.app/settings.json" },
        { "path": "$HOME/Library/Application Support/com.ai-chat.app/settings.json" },
        { "path": "$HOME/.pi/**" },
        { "path": "$RESOURCE/**" }
      ]
    }
  ]
}