{
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://auth.openai.com/**" },
        { "url": "https://chatgpt.com/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://html.duckduckgo.com/**" },
        { "url": "https://r.jina.ai/**" },
        { "url": "https://api.github.com/**" },
        { "url": "https://api.open-meteo.com/**" }
      ]
    },
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "pi-agent",
          "cmd": "pi",
          "sidecar": false,
          "args": [
            "--mode", "rpc",
            "--no-session",
            "--no-builtin-tools",
            "--no-extensions",
            "--no-skills",
            "--no-prompt-templates",
            "--no-context-files",
            "--extension", { "validator": "^.+ai-chat-bridge\\.ts$" },
            "--provider", { "validator": "^(openai|openai-codex)$" },
            "--model", { "validator": "^[A-Za-z0-9._:/-]{1,128}$" }
          ]
        },
        {
          "name": "pi-version",
          "cmd": "pi",
          "sidecar": false,
          "args": ["--version"]
        },
        {
          "name": "codex-version",
          "cmd": "codex",
          "sidecar": false,
          "args": ["--version"]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/AIChat" },
        { "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/AIChat/**" }
      ]
    }
  ]
}
