# Copy to .env for local development. Loaded into tests by vitest.config.ts and
# ignored by git. The dev/server pnpm scripts pass their own values via cross-env,
# so this file matters mainly for the test suite.

# Enables the PostgreSQL contract tests in apps/server/src/postgres.test.ts.
# They are skipped when it is unset. Requires: pnpm dev:infra
# It MUST NOT be the dev database: every test TRUNCATEs every table.
TEST_DATABASE_URL=postgres://forage:forage@127.0.0.1:55437/forage_contract_test

# Read by the server CLIs (pnpm server:tokens, pnpm server:bootstrap) and the
# API itself. Not used by any test.
DATABASE_URL=postgres://forage:forage@127.0.0.1:55437/forage_test
FORAGE_INSTANCE_ID=local-development
FORAGE_ASSET_DIR=../../.local/forage-assets

# Required by the API: every server process executes agent runs, so it always
# needs the credential encryption key. VERSION:BASE64 with a 32-byte key.
# Generate one with: node -e "console.log('1:' + require('node:crypto').randomBytes(32).toString('base64'))"
FORAGE_AGENT_ENCRYPTION_KEY=1:<base64-encoded-32-byte-key>
