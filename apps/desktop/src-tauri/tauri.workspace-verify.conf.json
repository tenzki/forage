{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forage workspace verification",
  "version": "0.1.0",
  "identifier": "com.forage.workspace-verification",
  "build": {
    "frontendDist": "../verification-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/pi/sidecar/dist"]
  }
}
