{
  "name": "@forage/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec turbo run build --filter=forage-sidecar && node scripts/sync-dev-sidecar.mjs && tauri dev",
    "dev:web": "vite --port 1420",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:workspace-verify": "tsc -p tsconfig.workspace-verify.json && vite build --config vite.workspace-verify.config.ts",
    "test:workspace-native": "node scripts/verify-workspace.mjs",
    "test:workspace-layout": "FORAGE_WORKSPACE_LAYOUT_ONLY=1 node scripts/verify-workspace.mjs",
    "build:onboarding-verify": "tsc -p tsconfig.workspace-verify.json && vite build --config vite.onboarding-verify.config.ts",
    "test:onboarding-native": "node scripts/verify-onboarding.mjs",
    "test:pane-resources": "node scripts/verify-pane-resources.mjs",
    "test:pane-shortcuts": "node scripts/verify-pane-shortcuts.mjs",
    "test:pane-clipping": "node scripts/verify-pane-clipping.mjs",
    "test": "vitest run --config ../../vitest.config.ts --root ../.. apps/desktop/src"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@forage/agent-runtime": "workspace:*",
    "@forage/document": "workspace:*",
    "@forage/domain": "workspace:*",
    "@forage/protocol": "workspace:*",
    "@forage/pi-runtime": "workspace:*",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@tiptap/core": "^3.20.5",
    "@tiptap/extension-bullet-list": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@tiptap/suggestion": "^3.20.5",
    "cmdk": "^1.1.1",
    "fractional-indexing": "^3.2.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.4",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "zod": "^4.1.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typebox": "1.3.7",
    "vite": "^6"
  }
}
