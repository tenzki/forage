                },
                {
                  "type": "text",
                  "id": "X1ka6U",
                  "name": "04  Protect the reading space detail",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Place artwork beside content with a generous clear field. Keep square marks out of text, controls and the working outline.",
                  "lineHeight": 1.35,
                  "fontFamily": "$body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
