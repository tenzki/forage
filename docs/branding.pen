                  "lineHeight": 1.35,
                  "fontFamily": "$display",
                  "fontSize": 22,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CWnAL",
                  "name": "03  Use the botanical palette detail",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Forest and Moss form the plant; Violet and Lilac carry the bloom. Paper remains the breathing space.",
                  "lineHeight": 1.35,
                  "fontFamily": "$body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "EQLAW",
                  "name": "04  Protect the reading space",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "04  Protect the reading space",
                  "lineHeight": 1.35,
                  "fontFamily": "$display",
                  "fontSize": 22,
