                  "name": "02  Keep the botany recognizable",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "02  Keep the botany recognizable",
                  "lineHeight": 1.35,
                  "fontFamily": "$display",
                  "fontSize": 22,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "MBNXG",
                  "name": "02  Keep the botany recognizable detail",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use identifiable stems, leaves, buds and flowers. One asymmetrical specimen per composition is usually enough.",
                  "lineHeight": 1.35,
                  "fontFamily": "$body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "sb01h",
