                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A Zettelkasten is a personal tool for thinking and writing. It has hypertextual features to make a web of thought possible. The difference from other systems is that you create a web of thoughts instead of notes of arbitrary size and form.",
                              "lineHeight": 1.6,
                              "fontFamily": "$body",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "iiVAS",
