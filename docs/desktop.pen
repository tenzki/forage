                                  "name": "Paragraph",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Each note contains one idea, and each idea earns its place through the links it makes to the notes around it.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "$body",
                                  "fontSize": 15,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "kuRUO",
                              "name": "Heading",
                              "fill": "$ink",
                              "content": "The principle of atomicity",
                              "fontFamily": "$display",
                              "fontSize": 20,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "vHUlV",
                              "name": "Paragraph",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "To make the web of thought work, each note should be about one thing and one thing only. The note's address — its identity — is what lets you link to it from anywhere.",
