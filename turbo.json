{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "LOG_LEVEL",
        "FORAGE_*"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@forage/server#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@forage/website#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/branding-assets/**",
        "$TURBO_ROOT$/docs/ApfelGrotezk-Regular.otf"
      ],
      "env": ["WEBSITE_URL"],
      "outputs": ["dist/**"]
    },
    "forage-sidecar#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "typecheck": {
      "cache": false
    }
  }
}
