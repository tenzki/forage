# Copy this file outside the checkout, replace both generated secrets, and keep
# the resulting file mode at 0600. It is shell-compatible so it can be sourced
# before running the server CLI commands.

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_USER=forage_server
POSTGRES_DB=forage_server
POSTGRES_PORT=55438
DATABASE_URL=postgres://forage_server:${POSTGRES_PASSWORD}@127.0.0.1:55438/forage_server

# Keep this identity stable after a desktop has connected.
FORAGE_INSTANCE_ID=home-server
FORAGE_HOST=127.0.0.1
FORAGE_PORT=3220
FORAGE_ASSET_DIR=${HOME}/.local/share/forage-server/assets
FORAGE_OWNER_EMAIL=owner@forage.invalid

# Generate with:
# node -e "console.log('1:' + require('node:crypto').randomBytes(32).toString('base64'))"
FORAGE_AGENT_ENCRYPTION_KEY=1:replace_with_a_base64_encoded_32_byte_key
LOG_LEVEL=info
